{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Downtify",
  "version": "0.1.0",
  "identifier": "dev.george.downtify",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:14230",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Downtify",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 520,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,HardwareMediaKeyHandling,MediaSessionService",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}